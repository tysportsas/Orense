# Copia este archivo a ".env.local" para desarrollo local, y define las
# mismas dos variables en Vercel → tu proyecto → Settings → Environment
# Variables. Ambas se obtienen en Supabase → tu proyecto → Settings → API.
#
# Son claves PÚBLICAS (anon key): están pensadas para ir en el navegador.
# La seguridad real la da la RLS (Row Level Security) de supabase/schema.sql,
# no el secreto de esta clave. Nunca pongas aquí la "service_role key".

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
